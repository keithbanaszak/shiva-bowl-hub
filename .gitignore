# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
dev.log
srv.log

# NOTE: data/leagues/<slug>/ IS committed on purpose — the per-league source of
# truth. The canonical paths below are MATERIALIZED for the active league at
# build time by scripts/select-league.mjs, so they are derived artifacts, not
# source, and must stay ignored (otherwise a pioneer build would commit pioneer
# data over shiva's canonical copy).
/data/marts/
/data/players.json
/data/league-config.json
/public/search-index.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
